# Use Node.js slim image
FROM node:20-slim

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Increase Node.js memory limit
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files to maintain workspace structure
COPY apps/client/package.json ./apps/client/
COPY apps/server/package.json ./apps/server/
COPY packages/core/package.json ./packages/core/
COPY packages/globals/package.json ./packages/globals/
COPY packages/i18n/package.json ./packages/i18n/
COPY packages/purge-builds/package.json ./packages/purge-builds/
COPY packages/types/package.json ./packages/types/
COPY config/package.json ./config/

# Setup GitHub packages authentication
ARG GITHUB_TOKEN
RUN echo "//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}" > .npmrc && \
    echo "@finografic:registry=https://npm.pkg.github.com" >> .npmrc

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY . .

# Build packages using Turborepo to ensure correct build order
RUN pnpm turbo build

# Expose ports
# Client port
EXPOSE 3000
# API/Server port
EXPOSE 4040

# Start the application
CMD ["pnpm", "start"]
