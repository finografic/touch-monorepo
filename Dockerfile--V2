# Use Node.js slim image
FROM node:20-slim

# Set working directory
WORKDIR /app

# Increase Node.js memory limit
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Copy all files from your already built monorepo
COPY . .

# Expose ports
EXPOSE 3000
EXPOSE 4040

# Start the application
CMD ["pnpm", "start"]
