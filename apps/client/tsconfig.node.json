{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "postcss.config.mjs",
    "src/utils/**/*.ts",
    "messages/**/*.json",
    "project.inlang/**/*",
    "src/i18n/utils/**/*.ts",
  ],
  "exclude": [
    "eslint.config.mjs"
  ]
}
