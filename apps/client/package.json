    "date-fns-tz": "3.2.0",
    "dnd-core": "16.0.1",
    "drizzle-admin": "0.0.8",
    "google-translate-api-x": "10.7.2",
    "hashids": "^2.3.0",
    "http-status-codes": "2.3.0",
    "i18next": "25.6.3",
    "i18next-browser-languagedetector": "8.2.0",
    "i18next-fs-backend": "2.6.1",
    "i18next-http-backend": "3.0.2",
    "idb-keyval": "6.2.2",
    "localstorage-slim": "2.7.1",
    "lodash": "4.17.21",
    "lucide-react": "0.554.0",
    "match-sorter": "8.1.0",
    "primereact": "10.9.7",
