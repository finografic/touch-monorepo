    "react-i18next": "16.3.5",
    "react-json-tree": "0.20.0",
    "react-router-dom": "7.9.6",
    "styled-components": "6.1.19",
    "tailwind-merge": "3.4.0",
    "tailwind-scrollbar-hide": "4.0.0",
    "tailwindcss": "4.1.17",
    "tailwindcss-animate": "1.0.7",
    "ts-extras": "0.16.0",
    "type-fest": "^5.2.0",
    "unplugin-turbo-console": "2.3.0",
