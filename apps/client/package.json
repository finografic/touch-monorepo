{
  "name": "@workspace/client",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "panda codegen && panda cssgen && vite",
    "start": "vite preview",
    "·········· BUILD": "·····················································",
    "panda:codegen": "panda codegen && panda cssgen",
    "build": "panda codegen && panda cssgen && vite build",
    "build.production": "panda codegen && panda cssgen && vite build --mode production",
    "build.development": "panda codegen && panda cssgen && tsc && vite build --mode development",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "·········· PACKAGES": "···················································",
    "update.eslint-config": "pnpm update @finografic/eslint-config --latest",
    "update.project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "update.zustand-context": "pnpm update @finografic/zustand-context-creator --latest",
    "db.sqlite3.rebuild": "node ../../scripts/bin/sqlite-rebuild.js",
    "·········· UPDATE.DEPS": "···············································",
    "update.deps.all": "pnpm update --latest",
    "update.deps.ignore": "npx tsx ../../scripts/update-deps-ignore.ts",
    "·········· LINTING": "····················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "lint.prod": "cross-env NODE_ENV=production eslint .",
    "lint.fix.prod": "cross-env NODE_ENV=production eslint . --fix",
    "lint.strict": "cross-env STRICT_LINT=true eslint .",
    "lint.imports": "eslint src --rule \"simple-import-sort/imports:error\" --rule \"simple-import-sort/exports:off\"",
    "lint.imports.fix": "pnpm lint.imports --fix",
    "lint.DRY": "eslint \"./src/**/*.{ts,tsx}\" --fix-dry-run",
    "lint.fix.DEV": "eslint \"./src/**/*.{ts,tsx}\" --fix",
    "lint.DRY.consistent-type-imports": "eslint --rule 'ts/consistent-type-imports: error' --fix-dry-run ./src",
    "·········· TESTING": "····················································",
    "test.all": "vitest run --reporter=verbose",
    "test.filters": "vitest run src/utils/filters --reporter=verbose",
    "·········· UTILS": "······················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@bugsnag/cuid": "3.2.1",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@finografic/zustand-context-creator": "0.7.1",
    "@hookform/resolvers": "5.2.2",
    "@lix-js/plugin-json": "1.0.1",
    "@lix-js/sdk": "0.5.1",
    "@radix-ui/themes": "3.3.0",
    "@react-router/dev": "7.13.0",
    "@tanstack/query-sync-storage-persister": "5.90.22",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "5.91.3",
    "@tanstack/react-query-persist-client": "5.90.22",
    "@types/better-sqlite3": "^7.6.13",
    "@uidotdev/usehooks": "2.4.1",
    "@workspace/config": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/design-system": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/server": "workspace:*",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.3.6",
    "change-case": "5.4.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "color": "5.0.3",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dnd-core": "16.0.1",
    "drizzle-admin": "0.0.8",
    "google-translate-api-x": "10.7.2",
    "hashids": "^2.3.0",
    "http-status-codes": "2.3.0",
    "i18next": "25.8.7",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-fs-backend": "2.6.1",
    "i18next-http-backend": "3.0.2",
    "idb-keyval": "6.2.2",
    "localstorage-slim": "2.7.1",
    "lodash": "4.17.23",
    "lucide-react": "^0.564.0",
    "match-sorter": "8.2.0",
    "primereact": "10.9.7",
    "radix-themes-tw": "1.1.0",
    "react": "^18.3.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "6.1.1",
    "react-hook-form": "7.71.1",
    "react-i18next": "16.5.4",
    "react-json-tree": "0.20.0",
    "react-router-dom": "7.13.0",
    "styled-components": "6.3.9",
    "ts-extras": "0.17.0",
    "type-fest": "^5.4.4",
    "unplugin-turbo-console": "2.3.0",
    "use-debounce": "10.1.0",
    "usehooks-ts": "3.1.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "2.13.0",
    "@finografic/eslint-config": "9.0.8",
    "@finografic/project-scripts": "8.12.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@pandacss/dev": "^0.53.1",
    "@tanstack/eslint-plugin-query": "5.91.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash": "4.17.23",
    "@types/node": "20.11.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitejs/plugin-react-swc": "4.2.3",
    "@workspace/scripts": "workspace:*",
    "autoprefixer": "10.4.24",
    "better-sqlite3": "11.9.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "17.3.0",
    "happy-dom": "20.6.1",
    "lightningcss": "1.31.1",
    "shx": "0.4.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vite-plugin-checker": "0.12.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
