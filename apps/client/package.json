{
  "name": "@workspace/client",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "vite",
    "start": "vite preview",
    "·········· I18N.GENERATE": "·············································",
    "i18n.paraglide.compile": "pnpm paraglide-js compile --project ./project.inlang --outdir ./src/i18n",
    "i18n.machine-translate": "inlang machine translate --project project.inlang",
    "i18n.clean-cache": "rm -rf ./project.inlang/cache && m -rf ./src/i18n/**/{*,!*.md}",
    "·········· GENERATE_COLORS": "···········································",
    "colors:generate:all": "pnpm colors:generate:palette && pnpm colors:generate:themes && pnpm colors:generate:oklch-hex",
    "colors:generate:palette": "npx tsx src/styles/colors/utils/generateMyPalette.utils.ts",
    "colors:generate:themes": "npx tsx src/styles/colors/utils/generate-themes.utils.ts",
    "colors:generate:oklch-hex": "npx tsx src/styles/colors/utils/generate-oklch-hex-themes.ts",
    "·········· BUILD": "·····················································",
    "build": "pnpm colors:generate:all && vite build",
    "build.production": "pnpm colors:generate:all && vite build --mode production",
    "build.development": "pnpm colors:generate:all && tsc && vite build --mode development",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "·········· PACKAGES": "···················································",
    "update.eslint-config": "pnpm update @finografic/eslint-config --latest",
    "update.project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "update.zustand-context": "pnpm update @finografic/zustand-context-creator --latest",
    "db.sqlite3.rebuild": "node ../../scripts/bin/sqlite-rebuild.js",
    "·········· UPDATE.DEPS": "···············································",
    "update.deps.all": "pnpm update --latest",
    "update.deps.ignore": "npx tsx scripts/update-deps-ignore.ts",
    "·········· LINTING": "····················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "lint.prod": "cross-env NODE_ENV=production eslint .",
    "lint.fix.prod": "cross-env NODE_ENV=production eslint . --fix",
    "lint.strict": "cross-env STRICT_LINT=true eslint .",
    "lint.imports": "eslint src --rule \"simple-import-sort/imports:error\" --rule \"simple-import-sort/exports:off\"",
    "lint.imports.fix": "pnpm lint.imports --fix",
    "lint.DRY": "eslint \"./src/**/*.{ts,tsx}\" --fix-dry-run",
    "lint.fix.DEV": "eslint \"./src/**/*.{ts,tsx}\" --fix",
    "lint.DRY.consistent-type-imports": "eslint --rule 'ts/consistent-type-imports: error' --fix-dry-run ./src",
    "·········· TESTING": "····················································",
    "test.all": "vitest run --reporter=verbose",
    "test.filters": "vitest run src/utils/filters --reporter=verbose",
    "·········· POSTCSS.TESTS": "··············································",
    "test": "mv postcss.config.mjs postcss.config.mjs.bak 2>/dev/null || true && vitest && mv postcss.config.mjs.bak postcss.config.mjs 2>/dev/null || true",
    "test.run": "mv postcss.config.mjs postcss.config.mjs.bak 2>/dev/null || true && vitest run && mv postcss.config.mjs.bak postcss.config.mjs 2>/dev/null || true",
    "test.watch": "mv postcss.config.mjs postcss.config.mjs.bak 2>/dev/null || true && vitest --watch",
    "test.ui": "mv postcss.config.mjs postcss.config.mjs.bak 2>/dev/null || true && vitest --ui",
    "test.colors": "mv postcss.config.mjs postcss.config.mjs.bak 2>/dev/null || true && vitest run src/styles/__tests__/ && mv postcss.config.mjs.bak postcss.config.mjs 2>/dev/null || true",
    "·········· UTILS": "······················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@bugsnag/cuid": "3.2.1",
