{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    // "baseUrl": ".",
    // "rootDir": "src",
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "sourceMap": true
  },
  "include": [
