{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    // "baseUrl": ".",
    // "rootDir": "src",
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "src/i18n/translations/*.json",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
