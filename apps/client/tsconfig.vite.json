{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    // "baseUrl": ".",
    // "rootDir": "src",
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "src/i18n/translations/*.json", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "eslint.config.mjs",
    "src/apps/client/src/components/ButtonRadix/radix-source-files/**/*",
    "src/apps/client/src/components/ButtonV1/**/*"
  ]
}
