  "exclude": [
    "node_modules",
    "dist",
    // "src/i18n/messages",
    // "src/i18n/*.js",
    // "src/i18n/.gitignore",
    // "src/i18n/.prettierignore",
    "eslint.config.mjs",
  ]
}