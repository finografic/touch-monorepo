{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": {
      "admin": ["./src/admin"],
      "admin/*": ["./src/admin/*"],
      "api": ["./src/api"],
      "api/*": ["./src/api/*"],
      "components/*": ["./src/components/*"],
      "config": ["./src/config"],
      "config/*": ["./src/config/*"],
      "constants/*": ["./src/constants/*"],
      "dev-tools": ["./src/dev-tools"],
      "dev-tools/*": ["./src/dev-tools/*"],
      "env.client": ["./env.client.ts"],
      "forms": ["./src/forms"],
      "forms/*": ["./src/forms/*"],
      "hooks/*": ["./src/hooks/*"],
      "layout/*": ["./src/layout/*"],
      "lib/*": ["./src/lib/*"],
      "pages": ["./src/pages"],
      "pages/*": ["./src/pages/*"],
      "providers/*": ["./src/providers/*"],
      "queries": ["./src/queries"],
      "queries/*": ["./src/queries/*"],
      "routes/*": ["./src/routes/*"],
      "styles": ["./src/styles"],
      "styles/*": ["./src/styles/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"],
      // Panda CSS — generated under ./styled-system (gitignored). App code may use either
      // `styled-system/jsx` or the same paths the DS bundle uses (`@styled-system/*`).
      // Keep @styled-system/* in sync with panda.config outdir + src/styled-system/recipes.ts.
      "styled-system": ["./styled-system"],
      "styled-system/*": ["./styled-system/*"],
      "@styled-system/css": ["./styled-system/css"],
      "@styled-system/jsx": ["./styled-system/jsx"],
      "@styled-system/recipes": ["./src/styled-system/recipes.ts"],
      // Custom aliases for specific use cases
      "@workspace/i18n/flags/images": ["./src/components/LanguageSelector/languages/images"],
      "@workspace/i18n/flags/images/*": ["./src/components/LanguageSelector/languages/images/*"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": false,
    "emitDeclarationOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "types": ["@emotion/react/types/css-prop", "vitest"],
    "typeRoots": ["../../packages/core/src/types", "../../node_modules/@types", "../../node_modules"]
  },
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../server"
    },
    {
      "path": "../../config"
    }
  ],
  "include": [
    "src/**/*",
    "src/**/*.json",
    "messages/**/*.json",
    "src/i18n/utils/**/*.ts",
    "env.client.ts",
    "vite.utils.ts",
    "styled-system"
  ],
  "exclude": ["dist", "node_modules", "eslint--V1.config.mjs"]
}
