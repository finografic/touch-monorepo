{
  "name": "@workspace/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/schemas": {
      "types": "./dist/db/schemas/index.d.ts",
      "import": "./dist/db/schemas/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "dev.v2": "tsup --watch --onSuccess 'node dist/index.js'",
    "dev.v1": "tsup src/index.ts --format cjs --watch --onSuccess 'node dist/index.js'",
    "start": "node dist/index.js",
    "·········· BUILD": "·····················································",
    "build": "tsup src/index.ts src/db/index.ts src/db/schemas/index.ts",
    "build.production": "cross-env NODE_ENV=production tsup",
    "build.development": "cross-env NODE_ENV=development tsup",
    "·········· CLEAN": "·····················································",
    "clean": "clean-all",
    "clean.dry": "clean-all --dry-run",
    "·········· PACKAGES": "···················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "db.sqlite3.rebuild": "pnpm add -D node-gyp && npm_config_build_from_source=true pnpm rebuild better-sqlite3",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "lint.prod": "cross-env NODE_ENV=production eslint .",
    "lint.fix.prod": "cross-env NODE_ENV=production eslint . --fix",
    "lint.strict": "cross-env STRICT_LINT=true eslint .",
    "·········· DB.BATCH": "··················································",
    "db.reset": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run",
    "db.setup": "NODE_OPTIONS='--import tsx' db-setup",
    "·········· DB.UTILS": "··················································",
    "db.drop": "shx rm -rf ../data/*.sqlite.db",
    "db.create": "drizzle-kit push --config ./drizzle.config.ts",
    "db.migrations.generate": "drizzle-kit generate",
    "db.migrations.auth": "tsx src/db/utils/seed.ts user",
    "db.migrations.seed": "tsx src/db/utils/seed.ts",
    "db.migrations.run": "tsx src/db/utils/migrate.ts",
    "·········· DB.STUDIO": "·················································",
    "db.studio": "drizzle-kit studio",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@bugsnag/cuid": "3.1.1",
    "@dotenvx/dotenvx": "1.31.3",
    "@hono/node-server": "1.13.5",
    "@hono/zod-openapi": "^0.18.3",
    "@hono/zod-validator": "0.4.3",
    "@scalar/hono-api-reference": "0.5.162",
    "@workspace/core": "workspace:*",
    "@workspace/config": "workspace:*",
    "@workspace/globals": "workspace:*",
    "@workspace/types": "workspace:*",
    "ansis": "^1.5.5",
    "better-auth": "1.0.22",
    "better-call": "0.3.3-beta.4",
    "better-sqlite3": "9.2.2",
    "colorette": "2.0.20",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dayjs": "1.11.13",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "hono": "4.6.10",
    "hono-pino": "0.6.0",
    "i18next": "24.2.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "stoker": "1.4.2",
    "uuid": "11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@finografic/eslint-config": "9.0.8",
    "@finografic/project-scripts": "^0.5.0",
    "@fullhuman/postcss-purgecss": "7.0.2",
    "@tanstack/eslint-plugin-query": "5.73.3",
    "@types/better-sqlite3": "^7.6.12",
    "@workspace/scripts": "workspace:*",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.28.1",
    "node-gyp": "11.0.0",
    "postcss": "^8.4.31",
    "postcss-import": "16.1.0",
    "postcss-nesting": "13.0.1",
    "shx": "0.3.4",
    "tsup": "8.3.6",
    "tsx": "4.19.2"
  }
}
