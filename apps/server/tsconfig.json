{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true, // Enables project references for better incremental builds
    "target": "ES2020", // Explicit target (though probably inherited from base)
    "module": "ESNext", // Explicit module format
    // "jsx": "react-jsx", // NOTE: if a public page is created
    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      // Local package absolute imports (relative to baseUrl: "./src")
      "config": ["./config"],
      "config/*": ["./config/*"],
      "constants/*": ["./constants/*"],
      "db": ["./db"],
      "db/*": ["./db/*"],
      "env.server": ["./env.server.d.ts"],
      "lib/*": ["./lib/*"],
      "middlewares/*": ["./middlewares/*"],
      "openapi/*": ["./openapi/*"],
      "routes/*": ["./routes/*"],
      "schemas": ["./schemas"],
      "schemas/*": ["./schemas/*"],
      "types": ["./types"],
      "types/*": ["./types/*"],
      "utils/*": ["./utils/*"],
      // Monorepo root references
      "drizzle.config": ["../../../drizzle.config"]
    },
    "allowJs": true,
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // ------------------------------------------------------------------------ //
    // TODO: DEV ONLY
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // ------------------------------------------------------------------------ //
    "declaration": true,
    "baseUrl": "./src",
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "skipDefaultLibCheck": true
  },
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../config"
    }
  ],
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
