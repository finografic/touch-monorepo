{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true, // Enables project references for better incremental builds
    "target": "ES2020", // Explicit target (though probably inherited from base)
    "module": "ESNext", // Explicit module format
    /* Bundler mode */
    "moduleResolution": "bundler",
    "rootDir": ".",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "config": ["./src/config"],
      "config/*": ["./src/config/*"],
      "constants/*": ["./src/constants/*"],
      "db": ["./src/db"],
      "db/*": ["./src/db/*"],
      "env.server": ["./env.server"],
      "lib/*": ["./src/lib/*"],
      "middlewares/*": ["./src/middlewares/*"],
      "openapi/*": ["./src/openapi/*"],
      "routes/*": ["./src/routes/*"],
      "schemas": ["./src/schemas"],
      "schemas/*": ["./src/schemas/*"],
      "services": ["./src/services"],
      "services/*": ["./src/services/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"],
      "drizzle.config": ["../../drizzle.config"]
    },
    "allowJs": true,
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // ------------------------------------------------------------------------ //
    // TODO: DEV ONLY
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // ------------------------------------------------------------------------ //
    "declaration": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "skipDefaultLibCheck": true
  },
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../config"
    }
  ],
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
