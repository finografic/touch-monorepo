{
  "name": "@touch/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "dev.v2": "tsup src/index.ts --format cjs --watch --onSuccess 'node dist/index.js'",
    "start": "node dist/index.js",
    "·········· BUILD": "·····················································",
    "build": "tsup src/index.ts",
    "build.production": "cross-env NODE_ENV=production tsup src/index.ts",
    "build.development": "cross-env NODE_ENV=development tsup src/index.ts",
    "·········· CLEAN": "·····················································",
    "clean": "tsx ../../scripts/clean-all.ts",
    "clean.dry": "tsx ../../scripts/clean-all.ts --dry-run",
    "·········· PACKAGES": "···················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest",
    "db.sqlite3.rebuild": "pnpm add -D node-gyp && npm_config_build_from_source=true pnpm rebuild better-sqlite3",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "lint.prod": "cross-env NODE_ENV=production eslint .",
    "lint.fix.prod": "cross-env NODE_ENV=production eslint . --fix",
    "lint.strict": "cross-env STRICT_LINT=true eslint .",
    "·········· DB.BATCH": "··················································",
    "db.reset": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run",
    "db.setup": "tsx ../../scripts/db.setup",
    "·········· DB.UTILS": "··················································",
    "db.drop": "rimraf --glob '../../data/*.sqlite.db'",
    "db.create": "drizzle-kit push --config ../../drizzle.config.ts",
    "db.migrations.generate": "drizzle-kit generate",
    "db.migrations.run": "pnpm db.migrations.run",
    "db.migrations.seed": "pnpm db.migrations.seed",
    "·········· DB.STUDIO": "·················································",
    "db.studio": "pnpm --filter @touch/server db.studio",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@bugsnag/cuid": "3.1.1",
    "@dotenvx/dotenvx": "1.31.3",
    "@fino/config": "workspace:*",
    "@fino/globals": "workspace:*",
    "@hono/node-server": "1.13.5",
    "@hono/zod-openapi": "^0.18.3",
    "@touch/shared": "workspace:*",
    "@scalar/hono-api-reference": "0.5.162",
    "ansis": "^1.5.5",
    "better-auth": "1.0.22",
    "better-call": "0.3.3-beta.4",
    "better-sqlite3": "^9.6.0",
    "colorette": "2.0.20",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dayjs": "1.11.13",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "hono": "4.6.10",
    "hono-pino": "0.6.0",
    "i18next": "24.2.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "stoker": "1.4.2",
    "uuid": "11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@finografic/eslint-config": "9.0.8",
    "@fullhuman/postcss-purgecss": "7.0.2",
    "@touch/scripts": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.31",
    "postcss-import": "16.1.0",
    "postcss-nesting": "13.0.1",
    "shx": "0.3.4",
    "tsup": "8.3.6",
    "tsx": "4.19.2"
  }
}
