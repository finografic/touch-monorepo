{
  "name": "@workspace/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/schemas": {
      "types": "./dist/db/schemas/index.d.ts",
      "import": "./dist/db/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/entities": {
      "types": "./dist/types/entities/index.d.ts",
      "import": "./dist/types/entities/index.js"
    },
    "./types/entities/*": {
      "types": "./dist/types/entities/*.d.ts",
      "import": "./dist/types/entities/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "tsx src/pre-startup.ts && tsx watch --tsconfig tsconfig.json src/index.ts",
    "dev.v2": "tsup --watch --onSuccess 'node dist/index.js'",
    "dev.v1": "tsup src/index.ts --format cjs --watch --onSuccess 'node dist/index.js'",
    "start": "node dist/index.js",
    "·········· BUILD": "·····················································",
    "build": "tsup src/index.ts src/db/index.ts src/db/schemas/index.ts",
    "build.production": "cross-env NODE_ENV=production tsup --config tsup.config.production.ts",
    "build.development": "cross-env NODE_ENV=development tsup src/index.ts src/db/index.ts src/db/schemas/index.ts",
    "build.production.v1": "cross-env NODE_ENV=production tsup",
    "build.development.v1": "cross-env NODE_ENV=development tsup",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "·········· PACKAGES": "···················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "db.sqlite3.rebuild": "node ../../scripts/bin/sqlite-rebuild.js",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "lint.prod": "cross-env NODE_ENV=production eslint .",
    "lint.fix.prod": "cross-env NODE_ENV=production eslint . --fix",
    "lint.strict": "cross-env STRICT_LINT=true eslint .",
    "·········· DB.BATCH": "··················································",
    "db.reset": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run",
    "db.reset.full": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run && pnpm db.setup && pnpm db.views.create",
    "db.reset.with-data": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run && pnpm db.setup",
    "db.setup": "NODE_OPTIONS='--import tsx' db-setup",
    "·········· DB.UTILS": "··················································",
    "db.drop": "shx rm -rf ../data/*.sqlite.db",
    "db.create": "drizzle-kit push --config ./drizzle.config.ts",
    "db.migrations.generate": "drizzle-kit generate",
    "db.migrations.auth": "tsx src/db/utils/seed.ts user",
    "db.migrations.seed": "tsx src/db/utils/seed.ts",
    "db.migrations.run": "tsx src/db/utils/migrate.ts",
    "db.views.create": "tsx src/db/utils/create-view.ts all",
    "db.views.create.single": "tsx src/db/utils/create-view.ts",
    "·········· DB.STUDIO": "·················································",
    "db.studio": "drizzle-kit studio",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "relay.reset": "tsx src/pre-startup.ts",
    "·········· TESTING": "·····················································",
    "test": "vitest",
    "test.run": "vitest run",
    "test.coverage": "vitest run --coverage",
    "test.watch": "vitest --watch",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@bugsnag/cuid": "3.2.1",
    "@dotenvx/dotenvx": "1.48.4",
    "@hono/node-server": "1.18.2",
    "@hono/zod-openapi": "^0.18.4",
    "@hono/zod-validator": "0.4.3",
    "@scalar/hono-api-reference": "0.9.13",
    "@types/serialport": "10.2.0",
    "@vitalets/google-translate-api": "9.2.1",
    "@workspace/core": "workspace:*",
    "ansis": "^3.0.0",
    "better-auth": "1.3.6",
    "better-call": "1.0.13",
    "better-sqlite3": "11.9.0",
    "chalk": "5.5.0",
    "colorette": "2.0.20",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dayjs": "1.11.13",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.5.1",
    "google-translate-api-x": "10.7.2",
    "hono": "4.9.2",
    "hono-pino": "0.8.0",
    "i18next": "25.3.6",
    "node-hid": "3.2.0",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "pino-pretty": "13.1.1",
    "serialport": "13.0.0",
    "stoker": "1.4.2",
    "uuid": "11.1.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@finografic/eslint-config": "9.0.8",
    "@finografic/project-scripts": "8.1.40",
    "@fullhuman/postcss-purgecss": "7.0.2",
    "@tanstack/eslint-plugin-query": "5.83.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "4.17.20",
    "@workspace/scripts": "workspace:*",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "^0.28.1",
    "node-gyp": "11.3.0",
    "postcss": "^8.5.6",
    "postcss-import": "16.1.1",
    "postcss-nesting": "13.0.2",
    "shx": "0.4.0",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "vitest": "^2.1.8"
  }
}
