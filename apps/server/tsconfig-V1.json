{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "module": "ESNext",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@workspace/config": ["../../config"],
      "@workspace/config/*": ["../../config/*"],
      "@workspace/core/*": ["../../packages/core/src/*"],
      "@workspace/core": ["../../packages/core/src"],
      "@workspace/globals/*": ["../../packages/globals/src/*"],
      "@workspace/globals": ["../../packages/globals/src"],
      "config": ["./src/config"],
      "config/*": ["./src/config/*"],
      "constants/*": ["./src/constants/*"],
      "db": ["./src/db"],
      "db/*": ["./src/db/*"],
      "drizzle.config": ["../../drizzle.config"],
      "env": ["./src/env"],
      "i18n/*": ["./src/i18n/*"],
      "lib/*": ["./src/lib/*"],
      "middlewares/*": ["./src/middlewares/*"],
      "openapi/*": ["./src/openapi/*"],
      "routes/*": ["./src/routes/*"],
      "schemas": ["./src/schemas"],
      "schemas/*": ["./src/schemas/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // ------------------------------------------------------------------------ //
    // TODO: DEV ONLY
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // ------------------------------------------------------------------------ //
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/globals"
    },
    {
      "path": "../../config"
    }
  ],
  "include": ["src/**/*", "src/**/*.json", "package.json"]
}
