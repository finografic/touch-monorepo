{
  "name": "touch-monorepo",
  "description": "ServiFresc",
  "version": "0.1.1",
  "private": true,
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "http://finografic.github.com/cv-justin-rankin"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "engines": {
    "node": ">=22.17.1",
    "pnpm": ">=10.17.1"
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "run-p dev.turbo db.studio",
    "dev.reset": "run-s reset",
    "dev.db.reset": "run-s db.reset",
    "dev.deploy": "pnpm build.deployment",
    "dev.client": "pnpm build.client && pnpm dev",
    "dev.i18n.update": "pnpm i18n.force && pnpm dev",
    "dev.turbo": "turbo run dev",
    "start": "turbo run start",
    "scripts": "tsx scripts/src/script-runner/script-runner.ts",
    "md.date-tags": "tsx scripts/src/add-md-date-tags.ts",
    "·········· PACKAGES": "··················································",
    "update.project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "update.eslint-config": "pnpm update @finografic/eslint-config --latest --recursive",
    "update.zustand-context": "pnpm --filter @workspace/client update.zustand-context",
    "·········· BUILD.DEPLOYMENT": "··········································",
    "build.deployment": "tsx packages/build-deployment/src/build-deployment.ts",
    "build": "turbo run build",
    "build.preview": "pnpm build && turbo run start",
    "build.client": "turbo run build --filter @workspace/client",
    "·········· RESET": "·····················································",
    "reset": "run-s clean reset.install reset.sync reset.build",
    "reset.sync": "pnpm syncpack.fix",
    "reset.install": "pnpm install",
    "reset.build": "pnpm build",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.turbo": "turbo run clean",
    "·········· I18N.CLIENT": "················································",
    "i18n.paraglide.compile": "pnpm --filter @workspace/client i18n.paraglide.compile",
    "i18n.machine-translate": "pnpm --filter @workspace/client i18n.machine-translate",
    "·········· I18N": "······················································",
    "i18n.update": "pnpm --filter @workspace/i18n update",
    "i18n.force": "pnpm --filter @workspace/i18n update.force",
    "i18n.reset": "pnpm --filter @workspace/i18n clean && pnpm i18n.update",
    "i18n.gen.codes": "pnpm --filter @workspace/i18n exec tsx src/generators/cli.ts",
    "·········· DB.BATCH": "··················································",
    "db.reset": "pnpm db.drop && pnpm db.migrations.generate && pnpm db.migrations.run && pnpm db.migrations.auth && pnpm db.setup && pnpm db.studio",
    "db.setup": "pnpm --package=@finografic/project-scripts dlx db-setup -y",
    "·········· DB.UTILS": "··················································",
    "db.drop": "shx rm -rf data/*.sqlite.db data/migrations",
    "db.create": "pnpm --filter @workspace/server db.create",
    "db.studio": "pnpm --filter @workspace/server db.studio",
    "db.sqlite3.rebuild": "pnpm --package=@finografic/project-scripts dlx sqlite-rebuild",
    "·········· DB.DATA": "···················································",
    "db.migrations.generate": "pnpm --filter @workspace/server db.migrations.generate",
    "db.migrations.auth": "pnpm --filter @workspace/server db.migrations.seed user",
    "db.migrations.seed": "pnpm --filter @workspace/server db.migrations.seed",
    "db.migrations.run": "pnpm --filter @workspace/server db.migrations.run",
    "db.views.create": "pnpm --filter @workspace/server db.views.create",
    "db.views.create.single": "pnpm --filter @workspace/server db.views.create.single",
    "·········· LINTING": "···················································",
    "lint": "turbo run lint",
    "lint.fix": "turbo run lint.fix",
    "lint.prod": "turbo run lint.prod",
    "lint.fix.prod": "turbo run lint.fix.prod",
    "lint.test-react": "tsx scripts/test-react-rules.ts",
    "lint.server": "pnpm --filter @workspace/server lint",
    "lint.client": "pnpm --filter @workspace/client lint",
    "lint.core": "pnpm --filter @workspace/core lint",
    "·········· UPDATE.DEPS": "···············································",
    "update.deps.all": "pnpm update --latest --recursive",
    "update.deps.root": "pnpm update -w",
    "update.deps.sync": "pnpm syncpack.fix",
    "update.deps.server": "run-s update.deps.server.local update.deps.sync",
    "update.deps.client": "run-s update.deps.client.local update.deps.sync",
    "update.deps.server.local": "pnpm --filter @workspace/server update.deps.ignore",
    "update.deps.client.local": "pnpm --filter @workspace/client update.deps.ignore",
    "update.deps.server.v1": "pnpm update --latest --filter @workspace/server",
    "update.deps.client.v1": "pnpm update --latest --filter @workspace/client",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· CHANGESET": "·················································",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "verify.deps": "pnpm -r exec pnpm install --no-frozen-lockfile",
    "postinstall": "node -e \"if (process.env.NODE_ENV !== 'production') { require('child_process').execSync('syncpack fix-mismatches --source package.json', {stdio: 'inherit'}) } else { console.log('Postinstall script skipped in production') }\"",
    "postinstall.no": "syncpack fix-mismatches --source 'package.json' && pnpm db.sqlite3.copy",
    "syncpack.fix": "syncpack fix-mismatches"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@inquirer/prompts": "7.1.0",
    "@workspace/core": "workspace:*",
    "chalk": "5.6.2",
    "del": "8.0.0",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.5.1",
    "mermaid": "11.6.0",
    "mermaid-react": "0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@emotion/babel-plugin": "11.13.5",
    "@finografic/eslint-config": "9.0.8",
    "@finografic/project-scripts": "8.2.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@microsoft/api-extractor": "^7.52.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eslint": "9.6.1",
    "@types/node": "20.11.24",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "@workspace/scripts": "workspace:*",
    "better-sqlite3": "11.9.0",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-format": "^0.1.3",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "node-gyp": "11.3.0",
    "npm-run-all": "^4.1.5",
    "pkg": "5.8.1",
    "prettier": "3.4.2",
    "shx": "0.4.0",
    "syncpack": "13.0.0",
    "tsx": "4.20.6",
    "turbo": "2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.13",
    "wait-on": "^8.0.5"
  },
  "peerDependencies": {
    "eslint": "^9.33.0",
    "prettier": "3.4.2",
    "react": "^18.3.1",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.9.2",
      "eslint": "^9.33.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "react-router": "^7.1.0",
      "@tanstack/react-query": "^5.90.10",
      "drizzle-orm": "^0.44.5",
      "zod": "^3.25.76"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  }
}
