{
  "name": "touch-monorepo",
  "description": "ServiFresc",
  "version": "0.0.2",
  "private": true,
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "http://finografic.github.com/cv-justin-rankin"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.15.0",
    "pnpm": ">=10.8.0"
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "scripts": "tsx scripts/src/script-runner/script-runner.ts",
    "gen.types": "tsx scripts/src/generate-types/generate-language-types.ts",
    "dev": "run-p dev:turbo db.studio",
    "dev.db.reset": "run-s db.reset",
    "dev.reset": "run-s reset",
    "dev:turbo": "turbo run dev",
    "dev.i18n.update": "pnpm i18n.force",
    "lint.fix.DEV": "eslint \"./apps/client/src/**/*.{ts,tsx}\"  --fix-dry-run --rule \"@typescript-eslint/consistent-type-imports: 2\"",
    "eslint-config.DEV": "dotenvx run -- pnpm update @finografic/eslint-config@9.0.8 --recursive",
    "dev.server": "pnpm --filter @workspace/server dev",
    "dev.client": "pnpm --filter @workspace/client dev",
    "start": "turbo run start",
    "start.server": "pnpm --filter @workspace/server start",
    "start.client": "pnpm --filter @workspace/client start",
    "·········· I18N": "·····················································",
    "i18n.update": "pnpm --filter @workspace/i18n update",
    "i18n.force": "pnpm --filter @workspace/i18n update.force",
    "i18n.reset": "pnpm --filter @workspace/i18n clean && pnpm i18n.update",
    "·········· RESET": "·····················································",
    "reset": "run-s clean.all reset.install reset.build",
    "reset.install": "pnpm install",
    "reset.build": "pnpm build",
    "·········· BUILD": "·····················································",
    "build": "turbo run build",
    "build.exclude": "turbo run build --filter=!@workspace/server",
    "build.types": "turbo run build --filter=@workspace/types --filter=@workspace/core",
    "build.types.rebuild": "run-s clean.types build.types",
    "build.production": "tsx scripts/src/production-build/build-production.ts",
    "build.production.ejs": "tsx scripts/src/production-build/build-production-ejs.ts",
    "·········· CLEAN": "·····················································",
    "clean": "turbo run clean",
    "clean.all": "rm -rf dist node_modules",
    "clean.all.V1": "./packages/purge-builds/dist/index.js --recursive",
    "clean.all.dry": "./packages/purge-builds/dist/index.js --recursive --dry-run",
    "clean.types": "turbo run clean --filter=@workspace/types --filter=@workspace/core",
    "·········· PACKAGES": "··················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest --recursive",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "db.sqlite3.rebuild": "pnpm add -D node-gyp && npm_config_build_from_source=true pnpm rebuild better-sqlite3",
    "·········· DB.BATCH": "··················································",
    "db.reset": "pnpm db.drop && pnpm db.migrations.generate && pnpm db.migrations.run && pnpm db.migrations.auth && pnpm db.setup && pnpm db.studio",
    "db.setup": "tsx scripts/src/db-setup/db-setup.ts -y",
    "·········· DB.UTILS": "··················································",
    "db.drop": "shx rm -rf data/*.sqlite.db data/migrations",
    "db.create": "pnpm --filter @workspace/server db.create",
    "db.studio": "pnpm --filter @workspace/server db.studio",
    "·········· DB.DATA": "·················································",
    "db.migrations.generate": "pnpm --filter @workspace/server db.migrations.generate",
    "db.migrations.auth": "pnpm --filter @workspace/server db.migrations.seed user",
    "db.migrations.seed": "pnpm --filter @workspace/server db.migrations.seed",
    "db.migrations.run": "pnpm --filter @workspace/server db.migrations.run",
    "db.views.create": "pnpm --filter @workspace/server db.views.create",
    "db.views.test": "pnpm --filter @workspace/server db.views.test",
    "·········· LINTING": "···················································",
    "lint": "turbo run lint",
    "lint.fix": "turbo run lint.fix",
    "lint.prod": "turbo run lint.prod",
    "lint.fix.prod": "turbo run lint.fix.prod",
    "lint.test-react": "tsx scripts/test-react-rules.ts",
    "·········· LINT.PACKAGES": "·············································",
    "lint.server": "pnpm --filter @workspace/server lint",
    "lint.client": "pnpm --filter @workspace/client lint",
    "lint.core": "pnpm --filter @workspace/core lint",
    "lint.config": "pnpm --filter @workspace/config lint",
    "·········· UPDATE.DEPS": "·····················································",
    "upgrade.deps.all": "pnpm update --latest --recursive",
    "upgrade.deps.root": "pnpm update -w",
    "upgrade.deps.client": "pnpm update --latest --filter @workspace/client",
    "upgrade.deps.server": "pnpm update --latest --filter @workspace/server",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· ELECTRON": "·····················································",
    "electron:dev": "cd electron && pnpm run dev",
    "electron:build": "./scripts/build-electron-comprehensive.sh win",
    "electron:build:mac": "./scripts/build-electron-comprehensive.sh mac",
    "electron:build:mac-arm": "./scripts/build-electron-comprehensive.sh mac-arm",
    "electron:build:mac-universal": "./scripts/build-electron-comprehensive.sh mac-universal",
    "electron:build:mac-app": "cd electron && pnpm run build:mac-app",
    "electron:build:mac-dmg": "cd electron && pnpm run build:mac-dmg",
    "electron:dist": "./scripts/build-electron-comprehensive.sh all",
    "·········· CHANGESET": "·················································",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "postinstall": "syncpack fix-mismatches --source 'package.json'",
    "postinstall.no": "syncpack fix-mismatches --source 'package.json' && pnpm db.sqlite3.copy",
    "sync-versions": "syncpack fix-mismatches",
    "verify.deps": "pnpm -r exec pnpm install --no-frozen-lockfile"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.31.3",
    "@hono/zod-openapi": "^0.18.4",
    "@inquirer/prompts": "7.1.0",
    "@workspace/config": "workspace:*",
    "@workspace/core": "workspace:*",
    "chalk": "5.3.0",
    "del": "8.0.0",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "mermaid": "11.6.0",
    "mermaid-react": "0.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@emotion/babel-plugin": "11.13.5",
    "@finografic/eslint-config": "9.0.8",
    "@finografic/project-scripts": "0.5.0",
    "@microsoft/api-extractor": "7.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eslint": "9.6.1",
    "@types/node": "20.15.0",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "@workspace/scripts": "workspace:*",
    "better-sqlite3": "11.10.0",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "drizzle-kit": "^0.30.6",
    "electron": "37.2.4",
    "electron-builder": "26.0.12",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-format": "^0.1.3",
    "eslint-plugin-jsonc": "2.18.2",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "node-gyp": "11.0.0",
    "npm-run-all": "^4.1.5",
    "pkg": "5.8.1",
    "prettier": "3.4.2",
    "shx": "0.3.4",
    "syncpack": "13.0.0",
    "tsx": "4.19.2",
    "turbo": "2.5.4",
    "type-fest": "4.30.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.33.1",
    "vitest": "2.1.6",
    "wait-on": "8.0.4"
  },
  "peerDependencies": {
    "eslint": "9.16.0",
    "prettier": "3.4.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
