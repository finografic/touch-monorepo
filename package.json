{
  "name": "touch-monorepo",
  "version": "0.0.2",
  "private": true,
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "http://finografic.github.com/cv-justin-rankin"
  },
  "workspaces": [
    "config",
    "packages/*",
    "apps/*"
  ],
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20.18.2",
    "pnpm": ">=10.8.0"
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "turbo run build --filter=@fino/config && turbo dev",
    "dev.server": "pnpm --filter @touch/server dev",
    "dev.client": "pnpm --filter @touch/client dev",
    "start": "turbo run start",
    "start.server": "pnpm --filter @touch/server start",
    "start.client": "pnpm --filter @touch/client start",
    "·········· RESET": "·····················································",
    "reset": "run-s clean.all reset.install reset.build",
    "reset.install": "pnpm install",
    "reset.build": "pnpm build",
    "·········· BUILD": "·····················································",
    "build": "turbo run build",
    "build.exclude": "turbo run build --filter=!@touch/server",
    "·········· CLEAN": "·····················································",
    "clean": "turbo run clean",
    "clean.all": "tsx scripts/clean-all.ts --recursive",
    "clean.all.dry": "tsx scripts/clean-all.ts --recursive --dry-run",
    "·········· PACKAGES": "··················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest --recursive",
    "db.sqlite3.rebuild": "pnpm add -D node-gyp && npm_config_build_from_source=true pnpm rebuild better-sqlite3",
    "·········· DB.BATCH": "··················································",
    "db.reset": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run",
    "db.setup": "tsx scripts/db.setup",
    "·········· DB.UTILS": "··················································",
    "db.drop": "rimraf --glob 'data/*.sqlite.db'",
    "db.create": "pnpm --filter @touch/server db.create",
    "db.studio": "pnpm --filter @touch/server db.studio",
    "·········· DB.DATA": "·················································",
    "db.migrations.generate": "pnpm --filter @touch/server db.migrations.generate",
    "db.migrations.run": "pnpm --filter @touch/server db.migrations.run",
    "db.migrations.seed": "pnpm --filter @touch/server db.migrations.seed",
    "·········· LINTING": "···················································",
    "lint": "turbo run lint",
    "lint.fix": "turbo run lint.fix",
    "lint.prod": "turbo run lint.prod",
    "lint.fix.prod": "turbo run lint.fix.prod",
    "·········· LINT.PACKAGES": "·············································",
    "lint.server": "pnpm --filter @touch/server lint",
    "lint.client": "pnpm --filter @touch/client lint",
    "lint.shared": "pnpm --filter @touch/shared lint",
    "lint.config": "pnpm --filter @fino/config lint",
    "·········· UPDATE.DEPS": "·····················································",
    "upgrade.deps.all": "pnpm update --latest --recursive",
    "upgrade.deps.root": "pnpm update -w",
    "upgrade.deps.client": "pnpm update --latest --filter @touch/client",
    "upgrade.deps.server": "pnpm update --latest --filter @touch/server",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "·········· CHANGESET": "·················································",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "postinstall": "syncpack fix-mismatches --source 'package.json'",
    "postinstall.no": "syncpack fix-mismatches --source 'package.json' && pnpm db.sqlite3.copy",
    "sync-versions": "syncpack fix-mismatches",
    "verify.deps": "pnpm -r exec pnpm install --no-frozen-lockfile"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.31.3",
    "@fino/config": "workspace:*",
    "@fino/globals": "workspace:*",
    "@hono/zod-openapi": "^0.18.4",
    "@inquirer/prompts": "7.1.0",
    "@touch/shared": "workspace:*",
    "chalk": "5.3.0",
    "del": "8.0.0",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "lodash": "4.17.21",
    "mermaid": "11.6.0",
    "mermaid-react": "0.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@emotion/babel-plugin": "11.13.5",
    "@finografic/eslint-config": "9.0.8",
    "@touch/scripts": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eslint": "9.6.1",
    "@types/lodash": "4.17.13",
    "@types/node": "^22.14.0",
    "better-sqlite3": "9.6.0",
    "cross-env": "7.0.3",
    "drizzle-kit": "^0.30.6",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-emotion": "11.0.0",
    "eslint-plugin-format": "^0.1.3",
    "eslint-plugin-jsonc": "2.18.2",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "node-gyp": "11.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.4.2",
    "shx": "0.3.4",
    "syncpack": "13.0.0",
    "tsx": "4.19.2",
    "turbo": "2.5.0",
    "type-fest": "4.30.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.6"
  },
  "peerDependencies": {
    "eslint": "9.16.0",
    "prettier": "3.4.2",
    "typescript": "^5.8.3"
  }
}
