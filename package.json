{
  "name": "touch-monorepo",
  "version": "0.0.2",
  "private": true,
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "http://finografic.github.com/cv-justin-rankin"
  },
  "workspaces": [
    "config",
    "packages/*",
    "apps/*"
  ],
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=10.6.0"
  },
  "scripts": {
    "==============": "=======================================================",
    "dev": "turbo run build --filter=@fino/config && turbo dev",
    "dev.server": "pnpm --filter @touch/server dev",
    "dev.client": "pnpm --filter @touch/client dev",
    "start": "turbo run start",
    "start.server": "pnpm --filter @touch/server start",
    "start.client": "pnpm --filter @touch/client start",
    "·········· RESET": "····································",
    "reset": "run-s reset.clean reset.install reset.build",
    "reset.clean": "rimraf '**/.pnpm' 'node_modules' '**/node_modules' '**/.turbo' '**/*.tsbuildinfo' 'pnpm-lock.yaml' && rimraf '**/.pnpm' 'node_modules' '**/node_modules' '**/.turbo' '**/*.tsbuildinfo' 'pnpm-lock.yaml'",
    "reset.install": "pnpm install --force",
    "reset.build": "turbo run build",
    "·········· BUILD": "··········································",
    "build": "turbo run build",
    "build.exclude": "turbo run build --filter=!@touch/server",
    "·········· CLEAN": "·····················································",
    "clean": "turbo run clean",
    "clean.deep": "rimraf --glob 'node_modules' '**/node_modules' 'dist' '**/dist' '.turbo' '**/.turbo' '*.tsbuildinfo' '**/*.tsbuildinfo' 'pnpm-lock.yaml'",
    "·········· PACKAGES": "··················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest --recursive",
    "eslint-config.reset": "dotenvx run -- pnpm -r exec pnpm remove @finografic/eslint-config && dotenvx run -- pnpm -r add -D @finografic/eslint-config",
    "·········· DB.UTILS": "···················································",
    "db.drop": "rimraf --glob 'data/*.sqlite.db'",
    "db.reset": "pnpm db.drop && pnpm db.create && pnpm db.migrations.run",
    "db.sqlite3.rebuild": "pnpm add -D node-gyp && npm_config_build_from_source=true pnpm rebuild better-sqlite3",
    "db.sqlite3.copy": "cp -R node_modules/better-sqlite3/build .",
    "db.sqlite3.copy.v2": "bash scripts/rebuild-better-sqlite3.sh",
    "db.create": "pnpm --filter @touch/server db.create",
    "db.setup.schemas": "tsx scripts/db-setup-schemas.ts",
    "db.migrations.generate": "pnpm --filter @touch/server db.migrations.generate",
    "db.migrations.run": "pnpm --filter @touch/server db.migrations.run",
    "db.migrations.seed": "pnpm --filter @touch/server db.migrations.seed",
    "db.studio": "pnpm --filter @touch/server db.studio",
    "·········· LINTING": "···················································",
    "lint": "turbo run lint",
    "lint.fix": "turbo run lint.fix",
    "lint.prod": "turbo run lint.prod",
    "lint.fix.prod": "turbo run lint.fix.prod",
    "·········· LINT.PACKAGES": "···················································",
    "lint.server": "pnpm --filter @touch/server lint",
    "lint.client": "pnpm --filter @touch/client lint",
    "lint.shared": "pnpm --filter @touch/shared lint",
    "lint.config": "pnpm --filter @fino/config lint",
    "·········· TOOLS": "·····················································",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "upgrade.all.deps": "pnpm update --latest --recursive",
    "·········· CHANGESET": "·················································",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "postinstall": "syncpack fix-mismatches --source 'package.json'",
    "postinstall.no": "syncpack fix-mismatches --source 'package.json' && pnpm db.sqlite3.copy",
    "sync-versions": "syncpack fix-mismatches",
    "verify.deps": "pnpm -r exec pnpm install --no-frozen-lockfile"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.31.3",
    "@fino/config": "workspace:*",
    "@fino/globals": "workspace:*",
    "@hono/zod-openapi": "^0.18.3",
    "@inquirer/prompts": "7.1.0",
    "@touch/shared": "workspace:*",
    "chalk": "5.3.0",
    "drizzle-orm": "^0.36.4",
    "drizzle-zod": "^0.5.1",
    "lodash": "4.17.21",
    "mermaid": "11.6.0",
    "mermaid-react": "0.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@emotion/babel-plugin": "11.13.5",
    "@finografic/eslint-config": "9.0.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/eslint": "9.6.1",
    "@types/lodash": "4.17.13",
    "@types/node": "^22.9.0",
    "better-sqlite3": "9.6.0",
    "cross-env": "7.0.3",
    "drizzle-kit": "^0.30.1",
    "eslint": "9.16.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-emotion": "11.0.0",
    "eslint-plugin-format": "^0.1.3",
    "eslint-plugin-jsonc": "2.18.2",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "node-gyp": "11.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.4.2",
    "shx": "0.3.4",
    "syncpack": "13.0.0",
    "tsx": "4.19.2",
    "turbo": "2.4.0",
    "type-fest": "4.30.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.6"
  },
  "peerDependencies": {
    "eslint": "9.16.0",
    "prettier": "3.4.2",
    "typescript": "^5.7.2"
  }
}
