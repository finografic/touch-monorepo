{
  "name": "@workspace/icons",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "icons": "lucide-manager dev",
    "icons.generate": "lucide-manager generate",
    "typecheck": "tsc --noEmit",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.564.0"
  },
  "devDependencies": {
    "@finografic/lucide-manager": "0.4.0",
    "@finografic/project-scripts": "8.12.0",
    "@types/react": "^18.3.12",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
