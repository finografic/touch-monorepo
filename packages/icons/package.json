{
  "name": "@workspace/icons",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit",

    "·· ICONS ···················································": "",
    "icons":          "tsx server/icons-server.ts",
    "icons.dev":      "concurrently -n \"server,picker\" -c \"cyan,green\" \"tsx server/icons-server.ts\" \"lucide-manager dev\"",
    "icons.generate": "tsx scripts/generate.ts",

    "·········· CLEAN": "·····················································",
    "clean":     "pnpm --package=@finografic/project-scripts dlx purge-builds --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.564.0"
  },
  "devDependencies": {
    "@finografic/lucide-manager": "link:../../../@finografic-lucide-manager",
    "@finografic/project-scripts": "8.12.0",
    "@hono/node-server": "^1.13.7",
    "@types/react": "^18.3.12",
    "concurrently": "^9.1.2",
    "hono": "^4.7.10",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
