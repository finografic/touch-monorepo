{
  "name": "@workspace/i18n",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/types.d.ts",
      "import": "./dist/config/index.js"
    },
    "./config/types": {
      "types": "./dist/config/types.d.ts",
      "import": "./dist/config/types.js"
    },
    "./config/defaults": {
      "types": "./dist/config/defaults.d.ts",
      "import": "./dist/config/defaults.js"
    },
    "./config/loader": {
      "types": "./dist/config/loader.d.ts",
      "import": "./dist/config/loader.js"
    },
    "./generators": {
      "types": "./dist/generators/index.d.ts",
      "import": "./dist/generators/index.js"
    },
    "./generators/generate-constants": {
      "types": "./dist/generators/generate-constants.d.ts",
      "import": "./dist/generators/generate-constants.js"
    },
    "./generators/generate-types": {
      "types": "./dist/generators/generate-types.d.ts",
      "import": "./dist/generators/generate-types.js"
    },
    "./generators/cli": {
      "types": "./dist/generators/cli.d.ts",
      "import": "./dist/generators/cli.js"
    },
    "./translations": {
      "import": "./dist/translations/index.js",
      "types": "./dist/translations/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "generate.types": "tsx src/generators/cli.ts",
    "generate.paraglide": "paraglide-js compile --project ./project.inlang --outdir ./dist/generated",
    "generate.paraglide:v1": "paraglide-js compile --project ./project.inlang",
    "dev": "tsup --watch",
    "·········· BUILD": "·····················································",
    "prebuild": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach && pnpm install",
    "build": "paraglide-js compile --project ./project.inlang --outdir ../../config/generated/i18n/app && tsup",
    "build:v2": "paraglide-js compile --project ./project.inlang --outdir ./dist/generated && tsup",
    "build:v1": "pnpm generate.paraglide:v1 && tsup",
    "build.with-paraglide": "pnpm generate.paraglide && tsup",
    "postbuild": "tsx src/generators/cli.ts",
    "·········· UPDATE": "····················································",
    "update": "run-s build refresh",
    "update.force": "run-s build refresh.force",
    "refresh": "run-s clean.client install.client",
    "refresh.force": "run-s clean.client.force install.client.force",
    "·········· CLIENT": "····················································",
    "clean.client": "pnpm --filter @workspace/client exec shx rm -rf node_modules/@workspace/i18n",
    "clean.client.force": "pnpm --filter @workspace/client exec shx rm -rf node_modules/@workspace/i18n && pnpm --filter @workspace/client exec shx rm -rf node_modules/.vite",
    "install.client": "pnpm install --filter @workspace/client",
    "install.client.force": "pnpm install --filter @workspace/client --force",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "·········· TOOLS": "···················································",
    "typecheck": "tsc --noEmit",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.48.4",
    "@inlang/paraglide-js": "2.4.0",
    "date-fns": "4.1.0",
    "i18next": "24.2.0",
    "i18next-browser-languagedetector": "8.0.2",
    "react-i18next": "15.4.0"
  },
  "devDependencies": {
    "@finografic/project-scripts": "8.2.0",
    "@inlang/cli": "3.0.12",
    "@microsoft/api-extractor": "^7.52.11",
    "@types/node": "20.11.24",
    "shx": "0.3.4",
    "tsup": "8.4.0",
    "typescript": "^5.9.2",
    "@inlang/paraglide-js": "2.4.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  }
}
