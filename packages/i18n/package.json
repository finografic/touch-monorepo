{
  "name": "@workspace/i18n",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "node": {
        "types": "./dist/index.node.d.mts",
        "import": "./dist/index.node.mjs"
      },
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config/types.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./config/types": {
      "types": "./dist/config/types.d.mts",
      "import": "./dist/config/types.mjs"
    },
    "./config/defaults": {
      "types": "./dist/config/defaults.d.mts",
      "import": "./dist/config/defaults.mjs"
    },
    "./config/loader": {
      "types": "./dist/config/loader.d.mts",
      "import": "./dist/config/loader.mjs"
    },
    "./generators": {
      "types": "./dist/generators/index.d.mts",
      "import": "./dist/generators/index.mjs"
    },
    "./generators/generate-constants": {
      "types": "./dist/generators/generate-constants.d.mts",
      "import": "./dist/generators/generate-constants.mjs"
    },
    "./generators/generate-types": {
      "types": "./dist/generators/generate-types.d.mts",
      "import": "./dist/generators/generate-types.mjs"
    },
    "./generators/cli": {
      "types": "./dist/generators/cli.d.mts",
      "import": "./dist/generators/cli.mjs"
    },
    "./translations": {
      "types": "./dist/translations/index.d.mts",
      "import": "./dist/translations/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./constants": {
      "types": "./dist/constants/index.d.mts",
      "import": "./dist/constants/index.mjs"
    },
    "./lib": {
      "types": "./dist/lib/locale.d.mts",
      "import": "./dist/lib/locale.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs"
    },
    "./iso-codes": {
      "types": "./dist/iso-codes/index.d.mts",
      "import": "./dist/iso-codes/index.mjs"
    }
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "generate:types": "tsx src/generators/cli.ts",
    "dev": "tsdown --watch --no-clean",
    "·········· BUILD": "·····················································",
    "prebuild": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach && pnpm install",
    "build": "tsdown",
    "postbuild": "tsx src/generators/cli.ts",
    "·········· UPDATE": "····················································",
    "update": "run-s build refresh",
    "update:force": "run-s build refresh:force db:reset",
    "db:reset": "pnpm -w db:reset",
    "refresh": "run-s clean:client install:client",
    "refresh:force": "run-s clean:client:force install:client:force",
    "·········· CLIENT": "····················································",
    "clean:client": "pnpm --filter @workspace/client exec shx rm -rf node_modules/@workspace/i18n",
    "clean:client:force": "pnpm --filter @workspace/client exec shx rm -rf node_modules/@workspace/i18n && pnpm --filter @workspace/client exec shx rm -rf node_modules/.vite",
    "install:client": "pnpm install --filter @workspace/client",
    "install:client:force": "pnpm install --filter @workspace/client --force",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean:dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "·········· TOOLS": "···················································",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "i18next": "25.8.7",
    "i18next-browser-languagedetector": "8.2.1",
    "react-i18next": "16.5.4"
  },
  "devDependencies": {
    "@finografic/project-scripts": "1.3.3",
    "@microsoft/api-extractor": "^7.52.11",
    "@types/node": "20.11.24",
    "shx": "0.4.0",
    "tsdown": "latest",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
