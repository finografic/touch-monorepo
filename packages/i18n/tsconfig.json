{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "constants": ["src/constants"],
      "constants/*": ["src/constants/*"],
      "data": ["src/data"],
      "data/*": ["src/data/*"],
      "iso-codes": ["src/iso-codes"],
      "iso-codes/*": ["src/iso-codes/*"],
      "translations": ["./src/translations"],
      "translations/*": ["./src/translations/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
