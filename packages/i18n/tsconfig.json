{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      // Local package absolute imports (relative to baseUrl: "./src")
      "config": ["./src/config"],
      "config/*": ["./src/config/*"],
      "constants": ["./src/constants"],
      "constants/*": ["./src/constants/*"],
      "data": ["./src/data"],
      "data/*": ["./src/data/*"],
      "docs": ["./src/docs"],
      "docs/*": ["./src/docs/*"],
      "generators": ["./src/generators"],
      "generators/*": ["./src/generators/*"],
      "iso-codes": ["./src/iso-codes"],
      "iso-codes/*": ["./src/iso-codes/*"],
      "lib": ["./src/lib"],
      "lib/*": ["./src/lib/*"],
      "models": ["./src/models"],
      "models/*": ["./src/models/*"],
      "translations": ["./translations"],
      "translations/*": ["./translations/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.json",
    "translations/**/*.json",
    "translations/index.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
