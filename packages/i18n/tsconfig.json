{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@config": ["../../../config"],
      "@config/*": ["../../../config/*"],
      "@config/i18n": ["../../../config/i18n.config.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.json", "src/translations/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
