{
  "name": "@workspace/core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api/index.d.mts",
      "import": "./dist/api/index.mjs"
    },
    "./api/*": {
      "types": "./dist/api/*.d.mts",
      "import": "./dist/api/*.mjs"
    },
    "./constants": {
      "types": "./dist/constants/index.d.mts",
      "import": "./dist/constants/index.mjs"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.mts",
      "import": "./dist/constants/*.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.mts",
      "import": "./dist/hooks/index.mjs"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.mts",
      "import": "./dist/hooks/*.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs"
    },
    "./types/*": {
      "types": "./dist/types/*.d.mts",
      "import": "./dist/types/*.mjs"
    },
    "./types/utils": {
      "types": "./dist/types/utils/index.d.mts",
      "import": "./dist/types/utils/index.mjs"
    },
    "./types/utils/*": {
      "types": "./dist/types/utils/*.d.mts",
      "import": "./dist/types/utils/*.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.mts",
      "import": "./dist/utils/*.mjs"
    },
    "./globals": {
      "types": "./dist/globals/index.d.mts",
      "import": "./dist/globals/index.mjs"
    },
    "./globals/*": {
      "types": "./dist/globals/*.d.mts",
      "import": "./dist/globals/*.mjs"
    }
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "tsdown --watch --no-clean",
    "·········· BUILD": "·····················································",
    "build": "tsdown",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "·········· PACKAGES": "···················································",
    "update.eslint-config": "pnpm update @finografic/eslint-config --latest",
    "update.project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/i18n": "workspace:*",
    "http-status-codes": "2.3.0",
    "lodash": "4.17.23",
    "react": "^18.3.1",
    "valibot": "1.2.0"
  },
  "devDependencies": {
    "@finografic/project-scripts": "8.12.0",
    "@types/eslint": "9.6.1",
    "@types/lodash": "4.17.23",
    "@types/node": "20.11.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "@workspace/scripts": "workspace:*",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "shx": "0.4.0",
    "tsdown": "^0.20.3",
    "tsx": "4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.55.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
