{
  "name": "@workspace/core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    },
    "./types/utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/types/utils/index.js"
    },
    "./types/utils/*": {
      "types": "./dist/types/utils/*.d.ts",
      "import": "./dist/types/utils/*.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./globals": {
      "types": "./dist/globals/index.d.ts",
      "import": "./dist/globals/index.js"
    },
    "./globals/*": {
      "types": "./dist/globals/*.d.ts",
      "import": "./dist/globals/*.js"
    }
  },
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "tsup --watch",
    "·········· BUILD": "·····················································",
    "build": "tsup",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "·········· PACKAGES": "···················································",
    "eslint-config": "pnpm update @finografic/eslint-config --latest",
    "project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/i18n": "workspace:*",
    "lodash": "4.17.21",
    "react": "^18.3.1",
    "stoker": "1.4.2"
  },
  "devDependencies": {
    "@finografic/project-scripts": "8.12.0",
    "@types/eslint": "9.6.1",
    "@types/lodash": "4.17.21",
    "@types/node": "20.11.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "@workspace/scripts": "workspace:*",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "shx": "0.4.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.47.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  }
}
