{
  "name": "@workspace/globals",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "../../packages/purge-builds/dist/index.js",
    "clean.dry": "../../packages/purge-builds/dist/index.js --dry-run",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@finografic/project-scripts": "^0.5.0",
    "@workspace/scripts": "workspace:*",
    "tsup": "^8.0.0",
    "tsx": "4.19.2"
  }
}
