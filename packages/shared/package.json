{
  "name": "@touch/shared",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "clean": "clean-all",
    "clean.dry": "clean-all --dry-run",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@finografic/project-scripts": "^0.2.3",
    "@touch/scripts": "workspace:*",
    "shx": "0.3.4",
    "tsx": "4.19.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  }
}
