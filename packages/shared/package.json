{
  "name": "@workspace/shared",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./constants": {
      "types": "./dist/constants/index.d.mts",
      "import": "./dist/constants/index.mjs"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.mts",
      "import": "./dist/constants/*.mjs"
    },
    "./models": {
      "types": "./dist/models/index.d.mts",
      "import": "./dist/models/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --no-clean",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.11.24",
    "tsdown": "*",
    "typescript": "^5.9.2"
  }
}
