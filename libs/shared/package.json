{
  "name": "@workspace/lib-shared",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "========== DEV": "=======================================================",
    "dev": "tsup --watch",
    "·········· BUILD": "·····················································",
    "build": "tsup",
    "·········· CLEAN": "·····················································",
    "clean": "clean-all",
    "clean.dry": "clean-all --dry-run",
    "·········· PACKAGES": "···················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@finografic/project-scripts": "^0.3.2",
    "@types/eslint": "9.6.1",
    "@types/node": "^20.11.5",
    "@workspace/scripts": "workspace:*",
    "eslint": "9.16.0",
    "shx": "0.3.4",
    "tsup": "8.4.0",
    "tsx": "4.19.2",
    "typescript-eslint": "8.18.2",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "dependencies": {
    "axios": "1.8.4",
    "stoker": "^1.0.0"
  }
}
