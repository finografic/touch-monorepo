{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@workspace/globals#build": {
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/config#build": {
      "dependsOn": ["@workspace/globals#build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/scripts#build": {
      "dependsOn": ["@workspace/config#build"],
      "outputs": ["dist/**", "bin/**", "*.tsbuildinfo"]
    },
    "@workspace/core#build": {
      "dependsOn": ["@workspace/config#build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/i18n#build": {
      "dependsOn": ["@workspace/core#build", "@workspace/config#build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/core#dev": {
      "dependsOn": ["@workspace/config#build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@workspace/core#build"],
      "env": ["NODE_ENV", "PORT"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
