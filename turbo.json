{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@workspace/types#build": {
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/globals#build": {
      "dependsOn": ["@workspace/types#build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/config#build": {
      "dependsOn": ["@workspace/globals#build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@workspace/common#build": {
      "dependsOn": ["@workspace/config#build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@workspace/common#build"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
