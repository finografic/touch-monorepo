{
  "name": "@workspace/scripts",
  "type": "module",
  "version": "0.3.2",
  "packageManager": "pnpm@10.17.1",
  "description": "local project-specific custom scripts",
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "http://finografic.github.com/cv-justin-rankin"
  },
  "license": "MIT",
  "keywords": [
    "project-scripts"
  ],
  "exports": {
    "./db-setup": {
      "types": "./dist/db-setup/index.d.ts",
      "import": "./dist/db-setup/index.js"
    },
    "./script-runner": {
      "types": "./dist/script-runner/index.d.ts",
      "import": "./dist/script-runner/index.js"
    }
  },
  "bin": {
    "db-setup": "bin/db-setup/db-setup.js",
    "sqlite-rebuild": "bin/sqlite-rebuild/sqlite-rebuild.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "========== DEV": "=======================================================",
    "watch": "tsup --format esm,cjs --watch",
    "md.date-tags": "tsx ./src/add-md-date-tags.ts",
    "eslint.config.inspect": "npx @eslint/config-inspector --config eslint.config.ts",
    "·········· BUILD": "·····················································",
    "build": "tsup",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "jsonc-eslint-parser": "^2.4.0"
  },
  "dependencies": {
    "@inquirer/confirm": "5.1.8",
    "@inquirer/core": "10.1.9",
    "@inquirer/input": "4.1.8",
    "@inquirer/prompts": "7.1.0",
    "@inquirer/search": "3.0.16",
    "del": "8.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@finografic/eslint-config": "9.0.8",
    "@types/node": "20.11.24",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.33",
    "chalk": "5.6.2",
    "dotenv": "^16.4.7",
    "env-cmd": "^10.1.0",
    "eslint": "^9.33.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-node": "^11.1.0",
    "globals": "16.5.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.2"
  }
}
