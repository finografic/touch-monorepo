{
  "name": "@workspace/scripts",
  "type": "module",
  "version": "0.3.2",
  "packageManager": "pnpm@10.8.0",
  "description": "Fingorafic Project Scripts",
  "author": {
    "name": "Justin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "http://finografic.github.com/cv-justin-rankin"
  },
  "license": "MIT",
  "keywords": [
    "project-scripts"
  ],
  "exports": {
    "./db-setup": {
      "types": "./dist/db-setup/index.d.ts",
      "import": "./dist/db-setup/index.js"
    },
    "./script-runner": {
      "types": "./dist/script-runner/index.d.ts",
      "import": "./dist/script-runner/index.js"
    }
  },
  "bin": {
    "db-setup": "bin/db-setup/db-setup.js",
    "sqlite-rebuild": "bin/sqlite-rebuild/sqlite-rebuild.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "========== DEV": "=======================================================",
    "db.test": "tsx ./src/db-setup",
    "dev.v2": "npx @eslint/config-inspector --config eslint.config.ts",
    "watch": "tsup --format esm,cjs --watch",
    "generate-types": "tsx ./src/generate-types/generate-language-types.ts",
    "process-iso-languages": "tsx ./src/generate-types/process-iso-languages.ts",
    "generate-comprehensive-mapping": "tsx ./src/generate-types/generate-comprehensive-language-mapping.ts",
    "·········· BUILD": "·····················································",
    "build": "tsup",
    "build.V2": "tsc && tsx ./scripts/build-bin.ts",
    "build.v1": "tsup --format esm,cjs --clean --dts",
    "·········· BUILD:V2": "·····················································",
    "build.v2": "tsup src/index.ts",
    "build.v2.production": "cross-env NODE_ENV=production tsup src/index.ts",
    "build.v2.development": "cross-env NODE_ENV=development tsup src/index.ts",
    "·········· CLEAN": "·····················································",
    "clean": "../../packages/purge-builds/dist/index.js",
    "clean.dry": "../../packages/purge-builds/dist/index.js --dry-run",
    "·········· PUBLISH.GITHUB": "············································",
    "prepublish.github": "pnpm build && git add dist/** && git commit -m \"chore: update generated files\" || true",
    "publish.github.patch": "pnpm prepublish.github && dotenvx run -- pnpm version patch && pnpm publish --registry https://npm.pkg.github.com",
    "publish.github.minor": "pnpm prepublish.github && dotenvx run -- pnpm version minor && pnpm publish --registry https://npm.pkg.github.com",
    "publish.github.major": "pnpm prepublish.github && dotenvx run -- pnpm version major && pnpm publish --registry https://npm.pkg.github.com",
    "·········· REGISTRIES": "··············································",
    "view.registry.gitub": "dotenvx run -- pnpm view @finografic/project-scripts --registry=https://npm.pkg.github.com",
    "·········· PACKAGES": "··················································",
    "eslint-config": "dotenvx run -- pnpm update @finografic/eslint-config --latest --recursive",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "·········· LINTING": "···················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "lint.prod": "cross-env NODE_ENV=production eslint .",
    "lint.fix.prod": "cross-env NODE_ENV=production eslint . --fix",
    "lint.strict": "cross-env STRICT_LINT=true eslint .",
    "·········· UTILS": "·····················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "upgrade.all.deps": "pnpm update --latest",
    "sqlite-rebuild": "tsx src/sqlite-rebuild/sqlite-rebuild.ts",
    "·········· HOOKS": "·····················································",
    "prepack": "pnpm build",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "jsonc-eslint-parser": "^2.4.0"
  },
  "dependencies": {
    "@inquirer/confirm": "5.1.8",
    "@inquirer/core": "10.1.9",
    "@inquirer/input": "4.1.8",
    "@inquirer/prompts": "7.1.0",
    "@inquirer/search": "3.0.16",
    "del": "8.0.0",
    "parse-gitignore": "^2.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.39.0",
    "@eslint/js": "9.23.0",
    "@finografic/eslint-config": "9.0.10",
    "@finografic/project-scripts": "1.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "20.15.0",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.33",
    "chalk": "5.4.1",
    "dotenv": "^16.4.7",
    "env-cmd": "^10.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^16.2.0",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.12.1",
    "tsup": "8.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
