# Environment Configuration Example
# Copy to .env.development or .env.production and fill in your values.
# Never commit real secrets — this file is the only env file tracked in git.

# -----------------------------------------------------------------------------
# GitHub (optional — used by some tooling / package installs)
# Create a token at: https://github.com/settings/tokens
# Scopes: repo (if private packages), read:packages as needed
GITHUB_TOKEN=your-github-token-here

# -----------------------------------------------------------------------------
# Application
NODE_ENV=development

# -----------------------------------------------------------------------------
# API server
API_PROTOCOL=http
API_HOST=localhost
API_PORT=4040
API_BASE_PATH=/api

# -----------------------------------------------------------------------------
# Client (Vite dev server / CORS origin)
CLIENT_PROTOCOL=http
CLIENT_HOST=localhost
CLIENT_PORT=3000

# -----------------------------------------------------------------------------
# Database (SQLite — file lives under data/)
DB_HOST=localhost
DB_USER=admin
DB_PASS=
DB_NAME=development.sqlite.db
DB_DIALECT=sqlite
DB_PORT=0

# -----------------------------------------------------------------------------
# Authentication (Auth.js / JWT)
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=your-super-secret-auth-key-minimum-32-characters-long
# Optional: true | false | unset. Unset in development = new JWT secret each API boot
# (sessions cleared on restart). Set false to keep JWTs across API restarts in dev.
# AUTH_INVALIDATE_JWT_ON_SERVER_BOOT=
AUTH_URL=http://localhost:4040
AUTH_COOKIE_PREFIX=touch-monorepo
TOKEN_COOKIE_SUFFIX=session_token
DATA_COOKIE_SUFFIX=session_data

# -----------------------------------------------------------------------------
# Google Translate (optional — i18n auto-translate via Inlang CLI)
# https://inlang.com/m/2qj2w8pu/app-inlang-cli
INLANG_GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# -----------------------------------------------------------------------------
# USB relay hardware (USBRelay8 defaults — adjust if your board differs)
RELAY_ENABLED=true
RELAY_NUM_RELAYS=16
RELAY_RECONNECT_ATTEMPTS=5
USBRELAY_VENDOR_ID=0x16c0
USBRELAY_PRODUCT_ID=0x05df
