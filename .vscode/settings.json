{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.enable": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "preferences.includePackageJsonAutoImports": "off",
    "suggest.autoImports": false
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.nodePath": null,
  "eslint.runtime": "node",
  "npm.packageManager": "pnpm",
  "eslint.useFlatConfig": true,
  "eslint.execArgv": null,
  "eslint.nodeEnv": null,
  "terminal.integrated.env.osx": {
    "NODE_PATH": ""
  },
  "json.schemas": [
    {
      "url": "https://cdn.jsdelivr.net/npm/tsup/schema.json",
      "fileMatch": ["package.json", "tsup.config.json"]
    }
  ],
  "debug.saveBeforeStart": "allEditorsInActiveGroup",
  "debug.javascript.terminalOptions": {
    "resolveSourceMapLocations": [
      "${workspaceFolder}/**",
      "!**/node_modules/**",
      "**/node_modules/.vite-temp/**"
    ]
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.hg/store/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/.next/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/.vite/**": true,
    "**/node_modules/.vite/**": true,
    "**/node_modules/.vite-temp/**": true
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "*.ejs": "javascript",
    "*.template": "javascript"
  },
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "i18n-ally.localesPaths": ["packages/i18n/src/translations"],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "cursor.ai.customInstructions": "DO NOT start development servers. User manages their own server instances. Server runs on localhost:4040, client on localhost:3000. Test APIs with curl before making changes. Never run npm run dev unless explicitly requested.",
  "cursor.ai.systemPrompt": "You are working in a monorepo with separate client and server apps. The user manages their own development servers. Focus on code changes and API testing, not server management.",
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.exclude": ["**/apps/client/src/api/query-v2/**"],
  "files.exclude": {
    "**/apps/client/src/api/query-v2": true
  },
  "search.exclude": {
    "**/apps/client/src/api/query-v2": true
  },
  "emmet.includeLanguages": {
    "javascript": "html"
  },
  "javascript.validate.enable": true,
  "typescript.validate.enable": true
}
