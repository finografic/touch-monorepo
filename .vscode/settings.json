{
  // IMPORTANT: ESLint must run BEFORE Prettier to preserve blank lines between import groups
  // Order: ESLint fixes imports (adds blank lines) → Prettier formats (preserves them)
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit", // Run ESLint FIRST (sorts imports, adds blank lines)
    "source.organizeImports": "never" // Disable built-in organize imports
  },
  // "editor.formatOnSave": true, // Run Prettier AFTER ESLint (formats but preserves blank lines)
  // "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.enable": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.nodePath": null,
  "eslint.runtime": "node",
  "npm.packageManager": "pnpm",
  "eslint.useFlatConfig": true,
  "eslint.execArgv": null,
  "eslint.nodeEnv": null,
  "terminal.integrated.env.osx": {
    "NODE_PATH": ""
  },
  "json.schemas": [
    {
      "url": "https://cdn.jsdelivr.net/npm/tsup/schema.json",
      "fileMatch": ["package.json", "tsup.config.json"]
    }
  ],
  "debug.saveBeforeStart": "allEditorsInActiveGroup",
  "debug.javascript.terminalOptions": {
    "resolveSourceMapLocations": [
      "${workspaceFolder}/**",
      "!**/node_modules/**",
      "**/node_modules/.vite-temp/**"
    ]
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.hg/store/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/.next/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/.vite/**": true,
    "**/node_modules/.vite/**": true,
    "**/node_modules/.vite-temp/**": true
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "*.ejs": "javascript",
    "*.template": "javascript"
  },
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  // "editor.acceptSuggestionOnEnter": "on",
  // "editor.acceptSuggestionOnCommitCharacter": false,
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  // i18n-ally Configuration
  // Point to the root translations folder where JSON files are located
  "i18n-ally.localesPaths": [
    "${workspaceFolder}/packages/i18n/translations",
    "${workspaceFolder}/packages/i18n/translations/ui",
    "${workspaceFolder}/packages/i18n/translations/app",
    "${workspaceFolder}/packages/i18n/translations/admin",
    "${workspaceFolder}/packages/i18n/src/translations",
    "${workspaceFolder}/packages/i18n/src/translations/ui",
    "${workspaceFolder}/packages/i18n/src/translations/app",
    "${workspaceFolder}/packages/i18n/src/translations/admin"
  ],
  // Enable i18next framework support
  "i18n-ally.enabledFrameworks": ["i18next"],
  // Set the namespace (matches your i18next config)
  "i18n-ally.namespace": true,
  "i18n-ally.defaultNamespace": "translations",
  // Key style: nested (since you use dot notation like ui.buttons.save)
  "i18n-ally.keystyle": "nested",
  // Source language (your default/fallback language)
  "i18n-ally.sourceLanguage": "es-ES",
  // Display language for the extension UI
  "i18n-ally.displayLanguage": "en-GB",
  // Path matcher: matches {domain}/{locale}.json pattern
  // This tells i18n-ally how to find locale files in your structure
  "i18n-ally.pathMatcher": "{domain}/{locale}.json",
  // Enable full nested key support
  "i18n-ally.enabledParsers": ["json"],

  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "cursor.ai.customInstructions": "DO NOT start development servers. User manages their own server instances. Server runs on localhost:4040, client on localhost:3000. Test APIs with curl before making changes. Never run npm run dev unless explicitly requested.",
  "cursor.ai.systemPrompt": "You are working in a monorepo with separate client and server apps. The user manages their own development servers. Focus on code changes and API testing, not server management.",
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.exclude": ["**/apps/client/src/api/query-v2/**"],
  "emmet.includeLanguages": {
    "javascript": "html"
  },
  "javascript.validate.enable": true,
  "typescript.validate.enable": true,

  // TypeScript Auto Import Settings (Built-in) - duplicates removed since already configured above
  "typescript.suggest.includeAutomaticOptionalChainCompletions": false,

  // JavaScript Auto Import Settings
  "javascript.suggest.autoImports": false,

  // Additional import-related settings
  "typescript.suggest.includeCompletionsForImportStatements": true,

  // ESLint will handle import sorting and organization

  // ============================================================================
  // Git & Diff View Settings - Control when diffs are shown
  // ============================================================================

  // Disable automatic diff opening
  "git.autoRepositoryDetection": false,
  "git.autofetch": false,

  // Only show diffs when explicitly requested
  "scm.diffDecorations": "none", // Don't show inline diff decorations
  "scm.diffDecorationsGutterVisibility": "hover", // Never show gutter decorations

  // Disable automatic diff view on file open
  "git.openRepositoryInParentFolders": "never",

  // Control Source Control panel behavior
  "scm.alwaysShowActions": false,
  "scm.alwaysShowRepositories": false,

  // Git diff settings - only show when explicitly requested
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.renderSideBySide": false,
  "diffEditor.codeLens": false, // Disable code lens in diff view

  // File explorer - don't show git status
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": false,

  // ============================================================================
  // Problems Panel Settings - Disable auto-opening
  // ============================================================================

  // Prevent Problems panel from auto-opening when issues are detected
  "problems.showCurrentInStatus": false, // Don't show problem count in status bar
  "problems.autoReveal": false, // Don't auto-reveal problems in editor
  // Disable automatic panel opening
  "workbench.panel.opensMaximized": "never", // Never auto-maximize panels
  "workbench.panel.defaultLocation": "bottom", // Keep it at bottom but don't auto-open

  // Terminal panel settings (if terminal is what's opening)
  "terminal.integrated.showExitAlert": false, // Don't show alerts when terminal exits

  // Output panel settings
  "output.smartScroll.enabled": false, // Disable smart scrolling in output

  // Disable automatic reveal of panels
  "workbench.editor.revealIfOpen": false, // Don't auto-reveal editors
  "workbench.editor.enablePreview": false, // Disable preview mode (prevents auto-opening)

  // Diagnostic/TypeScript settings
  "typescript.tsserver.experimental.enableProjectDiagnostics": false, // Disable project-wide diagnostics
  "typescript.disableAutomaticTypeAcquisition": false, // Keep this enabled but control panel

  // ESLint settings - prevent auto-opening
  "eslint.run": "onType", // Only run on type, not on save (reduces panel triggers)

  // SQLTools extension settings
  "sqltools.useNodeRuntime": false,

  // ============================================================================
  // Markdownlint Settings
  // ============================================================================
  "markdownlint.config": {
    "default": true,
    "MD025": false, // Allow multiple top-level headings (useful for TODO files)
    "MD040": false, // Don't require language for code blocks
    "MD041": false // Don't require first line to be a top-level heading
  }
  // "markdown.styles": [".vscode/markdown-github-light.css"]
}
