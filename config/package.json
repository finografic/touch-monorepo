{
  "name": "@workspace/config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./env.shared": {
      "import": "./dist/env.shared.js",
      "types": "./dist/env.shared.d.ts"
    },
    "./i18n.config": {
      "import": "./dist/i18n.config.js",
      "types": "./dist/i18n.config.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n.config.js",
      "types": "./dist/i18n.config.d.ts"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "types": "./dist/paths.d.ts"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "@workspace/core": "workspace:*",
    "chalk": "5.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.11.24"
  }
}
