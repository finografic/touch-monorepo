{
  "name": "@workspace/config",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./envShared": {
      "import": "./dist/env.shared.js",
      "types": "./dist/env.shared.d.ts"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "types": "./dist/paths.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup",
    "clean": "clean-all",
    "clean.dry": "clean-all --dry-run",
    "project-scripts": "dotenvx run -- pnpm update @finografic/project-scripts --latest --recursive",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.31.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@finografic/project-scripts": "^0.5.0",
    "@microsoft/api-extractor": "7.49.1",
    "@types/node": "20.15.0",
    "@workspace/scripts": "workspace:*",
    "@workspace/types": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "4.19.2",
    "typescript": "^5.8.3"
  }
}
