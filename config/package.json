{
  "name": "@fino/config",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./envShared": {
      "import": "./dist/env.shared.js",
      "types": "./dist/env.shared.d.ts"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "types": "./dist/paths.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup",
    "build.V1": "pnpm clean && tsc --build",
    "clean": "tsx ../../scripts/clean-all.ts",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.31.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.49.1",
    "@touch/scripts": "workspace:*",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3"
  }
}
