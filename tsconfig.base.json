{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@workspace/config": [
        "config/src"
      ],
      "@workspace/config/*": [
        "config/src/*"
      ],
      "@workspace/scripts": [
        "scripts/src"
      ],
      "@workspace/scripts/*": [
        "scripts/src/*"
      ],
      "@workspace/*": [
        "core/*/src"
      ],
      "@workspace/internal-*": [
        "internal/*/src"
      ]
    },
    "resolveJsonModule": true,
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ]
  }
}
