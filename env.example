# =============================================================================
# TOUCH MONOREPO - ENVIRONMENT CONFIGURATION EXAMPLE
# =============================================================================
# Copy this file to .env.development, .env.production, etc. and fill in your values
# =============================================================================

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================

# Application environment (development, production, test)
NODE_ENV=development

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================

# API Protocol (http, https)
API_PROTOCOL=http

# API Host (usually localhost for development)
API_HOST=localhost

# API Port (default: 4040)
API_PORT=4040

# API Base Path (default: /api)
API_BASE_PATH=/api

# =============================================================================
# CLIENT APPLICATION CONFIGURATION
# =============================================================================

# Client Protocol (http, https)
CLIENT_PROTOCOL=http

# Client Host (usually localhost for development)
CLIENT_HOST=localhost

# Client Port (default: 3000)
CLIENT_PORT=3000

# Client Origin (auto-generated from CLIENT_PROTOCOL://CLIENT_HOST:CLIENT_PORT)
# CLIENT_ORIGIN=http://localhost:3000

# Vite App Name (for client)
VITE_APP_NAME=Touch Monorepo

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Host (for SQLite, this is usually localhost)
DB_HOST=localhost

# Database User (for SQLite, this can be any string)
DB_USER=admin

# Database Password (optional for SQLite)
# DB_PASS=

# Database Name (file name for SQLite)
DB_NAME=development.sqlite.db

# Database Dialect (sqlite, mysql, postgres)
DB_DIALECT=sqlite

# Database Port (for SQLite, this is usually not used)
DB_PORT=0

# Database Path (auto-generated, but can be overridden)
# DB_PATH=./data/db/development.sqlite.db

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Better Auth Secret (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-super-secret-auth-key-minimum-32-characters-long

# Better Auth URL (your application URL)
BETTER_AUTH_URL=http://localhost:4040

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# For production, you might want to override these:
# NODE_ENV=production
# API_HOST=your-production-domain.com
# CLIENT_HOST=your-production-domain.com
# BETTER_AUTH_URL=https://your-production-domain.com
# DB_NAME=production.sqlite.db

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# For development, you might want to override these:
# NODE_ENV=development
# API_HOST=localhost
# CLIENT_HOST=localhost
# BETTER_AUTH_URL=http://localhost:4040
# DB_NAME=development.sqlite.db

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Pino Log Level (trace, debug, info, warn, error, fatal)
# PINO_LOG_LEVEL=info

# Disable Pino Worker Threads (set to 'true' to prevent crashes)
# PINO_DISABLE_WORKER_THREADS=true

# =============================================================================
# UPLOAD CONFIGURATION
# =============================================================================

# Upload Directory (relative to project root)
# UPLOAD_DIR=./data/uploads

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env.development for development
# 2. Copy this file to .env.production for production
# 3. Fill in your actual values (especially BETTER_AUTH_SECRET)
# 4. Never commit actual .env files to version control
# 5. The deployment build will automatically consolidate these settings
