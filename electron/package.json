{
  "name": "touch-client-electron",
  "version": "1.0.1",
  "description": "Touch Client Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64",
    "build:mac-arm": "electron-builder --mac --arm64",
    "build:mac-arm-app": "electron-builder --mac --arm64 --dir",
    "build:mac-universal": "electron-builder --mac --universal",
    "build:mac-app": "electron-builder --mac --dir",
    "build:mac-dmg": "electron-builder --mac dmg",
    "dist": "pnpm run build:win && pnpm run build:mac-universal",
    "test:app": "xattr -cr \"dist/Touch Client.app\" && open \"dist/Touch Client.app\"",
    "test:dmg": "open \"dist/Touch Client-1.0.1-arm64.dmg\""
  },
  "build": {
    "appId": "com.touch.client",
    "productName": "Touch Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "../apps/client/dist/**/*",
      "!../apps/server/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../apps/server/dist",
        "to": "apps/server/dist"
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "**/*",
          "!migrations/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "apps/server/dist/**/*",
      "data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "publish": null,
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "author": "Touch Client Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/finografic/touch-monorepo.git"
  },
  "devDependencies": {
    "electron-builder": "^25.1.0"
  }
}
